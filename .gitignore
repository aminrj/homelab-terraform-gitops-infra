# Terraform state & working dirs
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
crash.log

# Terraform variable files may contain secrets — ignore by default,
# allow-list the non-secret env files that are intentionally tracked.
*.tfvars
!environments/dev/terraform.tfvars
!environments/qa/terraform.tfvars

# OS / editor cruft
**/.DS_Store
.DS_Store
*_backup

# Local-only docs & backup artifacts
AGENTS.md
*.tar
*.tar.gz
